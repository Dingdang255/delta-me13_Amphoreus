 "ruwoshuo": [
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "1-1",
   "record_no": 1,
   "text": "太古的混沌静谧而黯沉，\n巨龙的胎儿自大地诞生。\n酣梦将巨龙的耳目遮掩。\n在它沉睡之时，\n艾格勒已经睁开百只眼眸，\n法吉娜也拨弄着嬉笑的浪。\n而吉奥里亚沉闷不语。\n层层山峦将巨龙包裹，\n那是世间最为宏伟的温床。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "1-2",
   "record_no": 2,
   "text": "巨龙的童年在黑暗中度过。\n自它睁开惺忪睡眼，\n便饥餐生铁、渴饮熔浆。\n直到有一日，巨龙昂首，\n以低沉的喉音，\n恳求警见光亮。\n泰坦以肋骨将它托举、慢慢向上，\n巨龙的脊梁割裂岩层、剖开土壤。\n当它来到地面，\n呼出星火织就的雾霭：\n方才借着巨鸟的眼眸，\n看清了自己的全貌。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "1-3",
   "record_no": 3,
   "text": "巨龙在大地上孤独行走。\n泰坦知晓它也会恐惧寂寞，\n于是用骨肉将新的兽群雕琢。\n蛮荒的世界中，\n巨龙引领着大地的兽群。\n过于漫长的寿命，\n给了巨龙望穿岁月的眼睛。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "",
   "record_no": 4,
   "text": "它见证过昼夜分割，\n还有理性与浪漫的纠葛。\n就连刻法勒，\n也不忘将金血分它一抔。\n海洋调笑说，\n哪怕大地沉没，\n它也不会腐朽。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "1-4",
   "record_no": 5,
   "text": "自睁目以来，\n巨龙便极少再度沉眠。\n因而，那偶尔在夜间进溅的迷梦，\n便在巨龙的记忆中刻下爪痕。\n梦中有它熟悉的众神，\n它们庞然依旧，\n却失了自由。\n是怎样宏伟的行者，\n才能将泰坦囚作倒影?",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "1-5",
   "record_no": 6,
   "text": "巨龙同样梦见自己的轨迹，\n那是来自苍穹，\n亦或苍穹之外的吐息。\n它梦见星间的碎银，\n倒映出另一条巨龙的身影。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "I 蛮荒古地之兽",
   "part_index": 1,
   "page_no": "",
   "record_no": 7,
   "text": "那青色的巨龙，\n朝着翁法罗斯而来，\n遥远的呢喃翻涌，\n成为刻在大地中的低吼。\n它识得那低吼中的含义，\n名为「不朽」。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "2-1",
   "record_no": 8,
   "text": "*「你是万千生灵之祖，」\n「一定要保护好兄姊弟妹……」*\n在茫茫大地跋涉的岁月，\n巨龙始终谨记泰坦的叮嘱。\n大地的兽群将它拱卫，\n畸态的奇兽腾挪咆哮，\n娇小的奇美拉攀上它的肩头。\n再后来，小小的人类诞生，\n他们在巨龙身畔飞奔，\n眨眼间又消失在各地。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "",
   "record_no": 9,
   "text": "「多美好的和平盛世……」\n可巨龙深邃的眼眸却泛起愁虑。\n亘古的它比泰坦更早看见，\n隐匿在深海中的凶潮。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "2-2",
   "record_no": 10,
   "text": "巨龙记得，\n在纷争降世的霎那，\n满溢之杯陡然轻叹，\n渎神的凶潮自海底侵展。\n忍受着咥啮骨肉的痛楚，\n吉奥里亚绷紧了神躯，\n再听不清造物的呼喊。\n「你的受苦，救不了此世生灵。」\n巨龙曾在泰坦胸脯宣誓效忠。\n而今，它沉默地转身远行，\n离开隔世的高原与山脉，\n走入那喧哗的万邦。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "2-3",
   "record_no": 11,
   "text": "时隔千年，巨龙恍然发觉，\n那些刻法勒的渺小造物，\n已让文明扎根于岁月。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "",
   "record_no": 12,
   "text": "*「怎…怎会有如此庞然的大地兽！」\n「那是大地兽吗？那是行走的摇钱树！」*\n好奇的居民惊叹于它的形貌，\n贪婪的掮客称量起它的价值。\n而巨龙只是泰然自若地举步，\n既不伤及分毫建筑，\n也不搭理任何人物。\n它聆听着生灵的语言，\n身躯隐没在战火与烽烟。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "2-4",
   "record_no": 13,
   "text": "数年之后，艾格勒闭上眼目，\n而巨龙的脚步终于受阻。\n一柄破浪的剑旗拦住去路，\n一位执棋的统帅仰头问询。\n「你就是那四处奔袭的大地兽？」\n统帅邀巨龙共猎神火。\n巨龙颔首，\n却并未看着统帅，\n也只字不提自己的由来。\n它亘古的视线，\n已经透过了逐火的终点……",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "II 掣曳裂土之龙",
   "part_index": 2,
   "page_no": "2-5",
   "record_no": 14,
   "text": "「吉奥里亚，就此伏诛！」\n因苦痛而昏聩的泰坦长叹着阖目——\n「我不怪你…荒蛮的万灵之祖。」\n霎那间，山脉震颤、陆地崩解。\n黑潮的割伤曾被泰坦填补，\n如今再度将大地撕裂。\n地坼的灾厄，\n该由谁来背负？\n巨龙应声沉入大地。\n那是吉奥里亚的胸膛，\n它出生的地方。\n翁法罗斯从此有神话流传——\n一匹巨龙将裂土掣曳拼合，\n使大地再度完固。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "3-1",
   "record_no": 15,
   "text": "又是百年的黄金战争。\n铁锈、哀嚎、生灵的血流，\n渗进大地，淌入巨龙衰颓的骨肉。\n震颜的岩层是巨龙的眼眸——\n它看见大地兽沦为役工与食粮，\n奇兽充当战争的兵戈。\n烽烟灭绝了它的兄姊弟妹，\n而巨龙无能为力。\n唯有愤懑地沉默，\n以及愧疚地回忆。\n只因那大地的试炼，\n便是忍受地上生灵的灾痛。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "3-2",
   "record_no": 16,
   "text": "直至末日的边界，\n巨龙已意志支离、鳞甲破碎。\n彼时迎接它的，\n并非那鲜花遍地的再创世......\n而是一柄沉沦已久的黑剑。\n「我们...虽素不相识......」\n「但请...交出火种...为了黎明。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "",
   "record_no": 17,
   "text": "黎明...黎明?\n若这毁灭的傀儡所念者为黎明，\n那逐火的终末...\n是何光景?\n黑潮的折磨、\n胞族的牺牲，\n是无妄的命运。\n还是徒劳的呻吟?",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "3-3",
   "record_no": 18,
   "text": "「我不...接受...!」\n褶曲的岩层如同怒涛。\n而那剑士并不生畏，只是喟叹，\n仿佛早已习以为常。\n锈蚀的骨节被逐一击碎。\n皲裂的皮囊剥落，\n倾洒金色的血液.....\n笼罩翁法罗斯的地震，\n持续了三个昼夜。\n不甘阖目之时。\n巨龙恍然——\n所谓的逐火......\n不过自怜的薪种，\n灾难的温床。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "3-4",
   "record_no": 19,
   "text": "然而，大地的归宿，\n并非都黯淡于黑色的剑影。\n在那次特殊的回归中，\n烈阳因灼烧「毁灭」而熄。\n彼时，巨龙方才沉入大地，\n仍咀嚼着背叛的痛意，\n却听得「长夜」的建音。\n「我需要一名帮手......」\n「守望『岁月』，直至尽头。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "",
   "record_no": 20,
   "text": "「长夜」拂袖，\n以忆潮将巨龙洗涤——\n于是，巨龙看见大地的今昔，\n也明了星空遥不可及。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "III 受难岩渊之神",
   "part_index": 3,
   "page_no": "3-5",
   "record_no": 21,
   "text": "第33550337次永劫回归，\n半神荒笛假称陨落，\n借记忆的潮水将存在冲淡，\n以大地的火种将方舟镕锻。\n在那千年的抗争之中，\n金血的英雄惨烈赴死，\n而巨龙只作未闻，\n静默地将流亡的胞族收攒。\n『长夜』的交易很简单——\n「岁月」将抹去「大地」的苦痛，\n使它酣眠于同伴的簇拥；\n而「大地」将成为「岁月」的盟友，\n唯它能守望......\n直到世界尽头。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "4-1",
   "record_no": 22,
   "text": "逐火的人杰们曾蔑视巨龙，\n只因它拒绝踏碎任何敌寇。\n「一头愚蠢的地兽...」\n「不愿为逐火献力的异种!」\n停留数日以后，\n巨龙向凯撒请辞，\n「逐火…是只属于人子的辉煌。」\n「你是仁爱的巨兽，」\n「我本无意将你囚留。」\n「禁伤无辜生灵的法令即将颁布..」\n「只需你未来替逐火出一次手。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "4-2",
   "record_no": 23,
   "text": "逐火是不断失却的旅途。\n可巨龙牢记着造主的嘱咐。\n离开凯撒的王都后，\n巨龙以其脊背托庇所见小兽，\n却遭贪图肉食的城邦围猎。\n飞箭如雨，穿不透巨龙的肌肤，\n却叫它背上的生灵哀嚎坠落。\n直到一支魁梧的援军，\n将这场悲剧终结——",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "",
   "record_no": 24,
   "text": "他们为巨龙架起盾墙\n又驱军踏碎了那座城邦。\n「山之民...本不好战。你是何人?」\n领军的骑士朗声回答：\n「我名「开山者」，吉奥刻勒斯。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "4-3",
   "record_no": 25,
   "text": "世人皆知，\n守护一切大地造物。\n是龙骑军的旗帜。\n世人还知。\n龙骑军战无不胜——\n「开山者」座下巨龙，\n沉默...却无坚不摧。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "",
   "record_no": 26,
   "text": "「坚忍对生存无益。」\n开山者总如此评价他的好友，\n而巨龙只答以低吟。\n不久，听闻逐火军的锋镝指向「大地」，\n龙骑全军启程，\n只为拱卫造主。\n行军前夜，巨龙却收到密信。\n「你的唯——次逐火.....」\n「须是弑主，而后求存。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "4-4",
   "record_no": 27,
   "text": "史载：临渊的战役中，\n龙骑军因荒笛倒戈而溃退，\n开山者卸甲，坠崖身亡。\n大地将背叛的记忆刻进岩层，\n直到「长夜」将它们翻阅。\n「大地啊，『岁月』愿销去你背叛的苦痛。」\n以忆灵之躯，\n伟岸的开山者与巨龙重逢。\n他的口中碎语喃喃：\n「...那一定不是你的选择。」\n而巨龙只答以低吟。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "4-5",
   "record_no": 28,
   "text": "巨龙与战友在深渊中相伴千年。\n直到星间的苍龙归来，\n激起命运的尘波。\n「他是同类.....」\n巨龙抬脸，注视那青色的龙裔，\n它知晓那具龙身背负着守护的誓命。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "IV 僭叛誓命之身",
   "part_index": 4,
   "page_no": "",
   "record_no": 29,
   "text": "而开山者眼中只有决绝。\n「那是『不朽』!」\n「不朽」治好巨龙的神躯，\n「不朽」能指引生存的末路。\n在世界的尽头，\n望着战友离去的身影，\n将死的巨龙摇头叹息。\n「所谓『不朽』，并非一颗宝药...」\n「而是一座桥梁。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "5-1",
   "record_no": 30,
   "text": "许久以后，仰望茫茫星夜，\n我总会思索。\n所谓不朽，意蕴究竟为何?",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "",
   "record_no": 31,
   "text": "荒笛所托的万千生灵，\n如今仍在我胸中涌动，\n如一尊永不止熄的熔炉。\n我曾想过为它们找寻家园，\n也曾试过在心中与它们沟通。\n但生灵们的存在，\n已无可分离。\n仿佛生来，\n便是我血脉的一道支系。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "5-2",
   "record_no": 32,
   "text": "「无可分离?」\n在我向众人诉说后，\n车厢中展开了激烈的讨论。\n「你会不会变成小奇美拉，」\n「钻进我们怀里撒娇...?」\n这是三月七放肆的畅想。\n「也可能是小海豹。」\n「奇兽也无妨...我一直想看看那个物种。」\n这是姬子和杨叔的宽慰。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "",
   "record_no": 33,
   "text": "「不管变成什么，丹恒都是丹恒。」\n嗯，她的话语竟然少见地抒情?\n「只是，要是成了大地兽，」\n「请务必要让我喂你红土!」\n「...想都别想。」",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "5-3",
   "record_no": 34,
   "text": "有时我会做这样的梦——\n万千生灵随我奔逃，\n在我们身后，\n黑色洪水遮天蔽日，\n仿佛要吞没一切生机。\n危难之际，\n生灵搭起龙形的桥梁，\n我率它们向星空蹇行。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "",
   "record_no": 35,
   "text": "在浩大行伍的末尾，\n一头巨龙停下脚步，\n目送我们远走。\n「大地的孩子终会自行其道......」\n「感谢你成为这座桥梁。」\n梦醒时分，\n我有所触动。\n也许不朽的承托，\n不是肉体的再造，\n亦非血脉的相融。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "5-4",
   "record_no": 36,
   "text": "某日翻阅智库时，\n我留意到寰宇物种的更新——\n一片汪洋的星球里，\n新生了喜欢碰撞的海豹。\n贫瘠的戈壁废土上。\n演化出贪嘴红土的曾群......\n许多熟悉的身影，\n在银河生态中活跃，\n却并非翁法罗斯的旧识。\n这是它们的新生，\n这是生命的出路。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "5-5",
   "record_no": 37,
   "text": "也许，我真如荒笛所愿，\n成为了为生命承重的桥?\n它曾踏裂山之民的战阵，\n撕开吉奥里亚的胸膛，\n咽下火种，又断然将其交付。\n造物总会背叛造主。\n正如文明的初始所目睹——\n孱弱的生灵背叛漆黑的海潮，\n登上陆地、攀上高枝，\n最终背叛家园、仰望星空。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  },
  {
   "part": "V 亘古求存之心",
   "part_index": 5,
   "page_no": "",
   "record_no": 38,
   "text": "胸中的熔炉仍在鼓动。\n在热流的间隙中，\n我偶尔也会恍惚，\n警见那银河之隙的庞然身影——\n那是一匹巨龙。\n名为「不朽」。",
   "source": "S-024",
   "source_url": "https://wiki.biligame.com/sr/%E8%8D%92%E7%AC%9B/%E5%A6%82%E6%88%91%E6%89%80%E4%B9%A6",
   "grade": "B"
  }
 ]
